cabal-version: 2.4
Name: caledon

Version: 3.3.0.1

Description:         a dependently typed, polymorphic, higher order logic programming language based on the calculus of constructions designed for easier metaprogramming capabilities. 

Synopsis:            a logic programming language based on the calculus of constructions

Homepage:            https://github.com/mmirman/caledon

License:             GPL-3.0-only

License-file:        LICENSE

Author:              Matthew Mirman

Maintainer:          Matthew Mirman <mmirman@andrew.cmu.edu>

Category:            Language, Interpreter

Build-type: Simple

tested-with: GHC == 9.14.1
extra-source-files: README.md, prelude/*.ncc, examples/*.ncc,
                    tests/fixtures/*.ncc


Source-repository head
  Type:     git
  Location: https://github.com/mmirman/caledon.git

common shared
  default-language: Haskell2010
  hs-source-dirs: sources


  other-modules: HOU, Choice, Parser, 
                 AST, TopoSortAxioms, 
                 Context, Options, Substitution, Names, Universe
                 Src.AST, Src.Context, Src.Elaborate, 
                 Src.FormulaSequence, Src.HOU, Src.LatticeUnify,
                 Src.Pipeline, Src.Reconstruction, Src.Substitution, 
                 Src.Tracing, Src.Translate, Src.Variables

  Build-depends: array >= 0.5 && < 0.6,
                 base >= 4.14 && < 5,
                 mtl >= 2.0 && < 3,
                 parsec >= 3.0 && < 4,
                 containers >= 0.5.8 && < 1,
                 transformers >= 0.3 && < 1,
                 cpphs >= 1.0 && < 2,
                 lens >= 5 && < 6,
                 deepseq >= 1 && < 2,
                 filepath >= 1.4 && < 1.6

  default-extensions: FlexibleContexts,
              FlexibleInstances,
              MultiParamTypeClasses,
              RecordWildCards,
              BangPatterns,
              TypeSynonymInstances,
              TemplateHaskell
              
executable caledon
  import: shared
  main-is: Main.hs

test-suite regression
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is: TestMain.hs
  build-depends: process >= 1.6 && < 1.7
  build-tool-depends: caledon:caledon



benchmark universes
  type: exitcode-stdio-1.0
  hs-source-dirs: benchmarks sources
  main-is: Universes.hs
  other-modules: Universe Names
  default-language: Haskell2010
  build-depends: base >= 4.14 && < 5, containers >= 0.4 && < 1,
                 array >= 0.5 && < 0.6, deepseq >= 1 && < 2
